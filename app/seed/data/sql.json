      "description": "List the `name` and `salary` of every employee who earns more than 80,000.",
      "tablesUsed": [
        "employees"
      ],
      "starterQuery": "-- Find employees earning more than 80,000\nSELECT ",
      "hints": [
        "Filter rows with a WHERE clause.",
        "Compare the salary column with the > operator."
      ],
      "requiredClauses": [
        {
          "fragment": "employees",
          "hint": "Query the employees table."
        },
        {
          "fragment": "where",
          "hint": "Filter rows with a WHERE clause."
        },
        {
          "fragment": "salary",
          "hint": "Your condition should use the salary column."
        },
        {
          "fragment": ">",
          "hint": "Use > to keep only salaries above the threshold."
        }
      ],
      "expectedColumns": [
        "name",
        "salary"
      ],
      "expectedRows": [
        {
          "name": "Alice Chen",
          "salary": 112000
        },
        {
          "name": "Brian Kim",
          "salary": 98000
        },
        {
          "name": "Derek Osei",
          "salary": 81000
        }
      ],
      "successNote": "Clean filter. On a large table, an index on salary would let the database skip non-matching rows entirely.",
      "ordered": false
