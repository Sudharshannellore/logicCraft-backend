# --- App ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- MongoDB -------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=codequest
# Seed catalog + demo data on startup when the database is empty.
SEED_ON_STARTUP=true
# Store checkout hands out XP with no payment. Keep false unless you're trying the store locally.
DEMO_CHECKOUT=false

# --- Auth --------------------------------------------------------------
# Signs access tokens. Keep it secret; changing it signs everyone out. Required in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Failed sign-ins allowed per email before it's locked for LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- External tutorial providers (all free) ---------------------------
HTTP_TIMEOUT_SECONDS=6
TUTORIAL_CACHE_TTL_SECONDS=43200
# Optional: raises the Stack Exchange quota from 300 to 10,000 requests/day.
STACKEXCHANGE_KEY=
# Optional: raises GitHub's API quota from 60 to 5,000 requests/hour (framework courses read docs repositories).
GITHUB_TOKEN=
# Optional: enables YouTube video tutorials (YouTube Data API v3 key).
YOUTUBE_API_KEY=
# Contact info sent in the User-Agent, as Wikimedia's API policy asks.
HTTP_USER_AGENT=Logicraft/0.1 (learning platform; contact: dev@logicraft.local)

# --- Code execution ---------------------------------------------------
# local    = run Python/JavaScript on this server in a locked-down child process
#            (memory/CPU/time limits, no files outside the stdlib, no network, no subprocesses)
# disabled = Run/Submit return an error
CODE_EXECUTOR=local
CODE_TIMEOUT_SECONDS=5
CODE_MEMORY_LIMIT_MB=256
CODE_MAX_OUTPUT_BYTES=64000
# How many submissions may run at the same time; the rest wait their turn.
CODE_MAX_CONCURRENT=4
# Whole Exercism test suites (Practice library) get longer than a single run.
EXERCISE_TIMEOUT_SECONDS=20
